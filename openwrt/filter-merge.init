#!/bin/sh /etc/rc.common
# localhost-only filter merger; AdGuard owns the update schedule
# shellcheck disable=SC2034
START=98
STOP=10
USE_PROCD=1

start_service() {
  mkdir -p /overlay/filter-merge/work
  chmod 700 /overlay/filter-merge /overlay/filter-merge/work
  procd_open_instance
  procd_set_param command /usr/bin/filter-merge serve /etc/filter-merge.conf
  procd_set_param respawn 3600 5 5
  procd_set_param file /etc/filter-merge.conf
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
